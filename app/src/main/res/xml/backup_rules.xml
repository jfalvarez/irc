<?xml version="1.0" encoding="utf-8"?><!--
   Copia de seguridad en Android 9 y 10 (API 29-30; desde la 31 manda data_extraction_rules.xml).
   Se copia todo salvo las preferencias: guardan la contraseña de NickServ en claro.
   La ruta es la del DataStore de androidModule (filesDir/datastore/USER_PREFERENCES_FILE).
-->
<full-backup-content>
    <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
</full-backup-content>
