<?xml version="1.0" encoding="utf-8"?><!--
   Copia de seguridad desde Android 12 (API 31+).
   En la nube se copia todo salvo las preferencias: guardan la contraseña de NickServ en claro.
   La transferencia directa entre móviles (cable o wifi, la inicia el usuario) lo copia todo.
   La ruta es la del DataStore de androidModule (filesDir/datastore/USER_PREFERENCES_FILE).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    </cloud-backup>
</data-extraction-rules>
